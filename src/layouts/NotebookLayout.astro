---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title}</title>
</head>

<body class="bg-paper">

  <div class="notebook">

    <div class="absolute inset-0 paper-texture"></div>

    <div class="margin-line"></div>

    <div class="top-line"></div>

    <slot />

  </div>

</body>
</html>