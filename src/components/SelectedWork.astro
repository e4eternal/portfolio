---
import Container from "./Container.astro";
---

<section id="work" class="py-32">

  <Container>

    <div class="space-y-4">

      <p class="font-mono text-orange-600 uppercase tracking-[0.25em]">
        01. SELECTED WORK
      </p>

      <h2 class="max-w-2xl text-6xl font-black leading-tight">
        A project I'm especially proud of.
      </h2>

    </div>

    <div class="relative mt-20 w-fit">

      <!-- tape -->

      <div
       class="
  absolute
  left-24
  -top-5
  h-12
  w-20
  rotate-[7deg]
  tape
        "
      ></div>

      <!-- paper -->

      <article
        class="tracing-paper relative max-w-3xl rotate-[-0.8deg] rounded-[6px] px-14 pt-14 pb-12"
      >
        <p class="font-semibold text-orange-600">
          Localization · Content Design
        </p>

        <h3 class="mt-5 text-5xl font-bold">
          Obsidian in Arabic
        </h3>

        <p class="mt-8 max-w-xl text-xl leading-9 text-neutral-700">
          Bringing one of the world's favorite knowledge management tools
          closer to Arabic speakers through thoughtful localization and content
          adaptation.
        </p>

        <a
          href="/work/obsidian"
          class="mt-12 inline-flex text-2xl font-semibold underline underline-offset-8"
        >
          See full notes →
        </a>
<p
  class="absolute right-10 top-8 font-mono text-sm tracking-widest text-neutral-400"
>
  Page 01
</p>
<p
  class="absolute bottom-6 right-8 rotate-2 font-serif italic text-sm text-neutral-400"
>
  Done solely by me
</p>
<div class="paper-curl"></div>
      </article>

    </div>

  </Container>

</section>