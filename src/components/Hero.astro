---
import Container from "./Container.astro";
---

<section class="py-16">
  <Container>
    <div class="max-w-xl">

      <h1 class="text-4xl font-bold leading-tight md:text-5xl">
        I make complex ideas simple, memorable, and worth reading.
      </h1>

      <p class="t-5 text-base leading-8 text-zinc-700">
        Through thoughtful content, localization, and storytelling.
      </p>

      <div class="mt-6 flex items-center gap-6">

        <a
          href="#work"
          class="rounded-md bg-yellow-300 px-5 py-2.5 font-medium transition hover:-translate-y-0.5"
        >
          Open Notebook →
        </a>

        <a
          href="https://ggl.link/khaled-mo-cc"
          class="text-zinc-700 underline underline-offset-4"
        >
          Resume.pdf
        </a>

      </div>

    </div>
  </Container>
</section>