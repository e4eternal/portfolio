---
import Container from "./Container.astro";
---

<footer class="mt-24">
  <Container>
    <div class="rounded-t-[40px] bg-[#F4D3A5] px-8 py-24 text-center md:px-16">
      <h2 class="text-5xl font-black tracking-tight">
        Thanks for reading.
      </h2>

      <p class="mt-5 text-xl text-neutral-700">
        Let's build something together.
      </p>

      <div class="mt-12 flex flex-wrap justify-center gap-8 text-lg font-medium">
        <a
          href="mailto:you@example.com"
          class="transition hover:text-[#E56B35]"
        >
          Email
        </a>

        <a
          href="https://linkedin.com/in/your-profile"
          target="_blank"
          class="transition hover:text-[#E56B35]"
        >
          LinkedIn
        </a>

        <a
          href="https://github.com/your-username"
          target="_blank"
          class="transition hover:text-[#E56B35]"
        >
          GitHub
        </a>
      </div>
    </div>
  </Container>
</footer>