  /* ─── Accordion ──────────────────── */
  .accordion-chevron {
    transition: transform 260ms ease;
  }

  .accordion-trigger[aria-expanded="true"] .accordion-chevron {
    transform: rotate(180deg);
  }

  /* ─── Achievement animations ─────── */
  .achievement-item.visible {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }
</style>


<script>
  // ─── Accordion ────────────────────────────────────────
  document.querySelectorAll('.accordion-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      const body = btn.nextElementSibling as HTMLElement;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      // Close all
      document.querySelectorAll('.accordion-trigger').forEach(b => {
        b.setAttribute('aria-expanded', 'false');
        const sibling = b.nextElementSibling as HTMLElement;
        if (sibling) sibling.classList.add('hidden');
      });

      // Open clicked if it was closed
      if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        body?.classList.remove('hidden');
      }
    });
  });


  // ─── Flywheel node detail ─────────────────────────────
  const detailPanel = document.getElementById('flywheel-detail') as HTMLElement;

  document.querySelectorAll('.flywheel-node').forEach(node => {
    const detail = (node as HTMLElement).dataset.detail;
    const inner = node.querySelector('.node-inner') as HTMLElement;

    inner?.addEventListener('mouseenter', () => {
      if (detailPanel && detail) {
        detailPanel.textContent = detail;
        detailPanel.classList.remove('hidden');
      }
    });

    inner?.addEventListener('mouseleave', () => {
      if (detailPanel) {
        detailPanel.classList.add('hidden');
      }
    });
  });


  // ─── Animated stat counters ───────────────────────────
  function animateCounter(el: HTMLElement) {
    const target = parseInt(el.dataset.target || '0', 10);
    const suffix = el.dataset.suffix || '';
    const isDecimal = el.dataset.decimal === '1';
    const duration = 1800;
    const startTime = performance.now();

    function formatNumber(n: number): string {
      if (isDecimal) return (n / 10).toFixed(1);
      if (n >= 1000) return (n / 1000).toFixed(0) + 'k';
      return n.toString();
    }

    function step(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      // easeOutExpo
      const eased = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
      const current = Math.round(eased * target);
      el.textContent = formatNumber(current) + suffix;
      if (progress < 1) requestAnimationFrame(step);
    }

    requestAnimationFrame(step);
  }

  // Intersection Observer for stats
  const statsSection = document.getElementById('stats-section');
  if (statsSection) {
    const statsObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          document.querySelectorAll('[data-target]').forEach(el => {
            animateCounter(el as HTMLElement);
          });
          statsObserver.disconnect();
        }
      });
    }, { threshold: 0.3 });
    statsObserver.observe(statsSection);
  }


  // ─── Achievement list stagger-in ─────────────────────
  const achievementsObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        document.querySelectorAll('.achievement-item').forEach(item => {
          item.classList.add('visible');
        });
        achievementsObserver.disconnect();
      }
    });
  }, { threshold: 0.2 });

  const achievementList = document.getElementById('achievements-list');
  if (achievementList) achievementsObserver.observe(achievementList);
</script>
